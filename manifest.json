{
  "manifest_version": 3,
  "name": "KULMS Video Downloader",
  "version": "1.4.1",
  "description": "교내 시스템 전용 오프라인 학습 지원 도구(Offline learning support tool exclusive to the campus system)",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "webNavigation",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.korea.ac.kr/*",
    "*://*.gov-ntruss.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LMS 영상 다운로더",
    "default_popup": "popup.html"
  }
}