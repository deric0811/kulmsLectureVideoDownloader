// ============================================================================
// KULMS Video Downloader — background.js (MV3 Service Worker)
// 버전 1.4.2 — 배지 라이프사이클 정상화 + 멀티/단일 감지 파이프라인 이원화
//
//   [v1.4.2 리팩토링 핵심]
//   1) 탭별 상태 SSOT(Single Source of Truth) = chrome.storage.session
//      (키: `tab_${tabId}`). SW 수면(Inactive)·재기동에도 상태가 휘발되지 않는다.
//   2) GET 배지는 chrome.action.setBadgeText({ text, tabId }) 로만 설정하며,
//      tabId 를 명시하면 SW 가 Inactive 가 되거나 다른 탭에 다녀와도
//      브라우저가 네이티브 차원에서 배지를 영구 보존한다.
//      → 감지 리스너에서 'await 전에 동기적으로' 배지를 먼저 설정한다
//        (SW 가 수면 직전이어도 배지 설정 명령이 유실되지 않도록 보장).
//   3) 배지·상태 초기화는 chrome.webNavigation.onBeforeNavigate 에서
//      주 프레임(frameId 0)의 실제 LMS 이동·새로고침 시에만 수행한다.
//      서브프레임(우리가 주입하는 다운로드 iframe) 이나 XHR API ping 으로는
//      절대 초기화되지 않는다. (tabs.onActivated 등 불필요한 리스너 없음)
//   4) 감지 파이프라인 이원화:
//      [멀티: chapter.xml 존재]
//        chapter.xml 요청 → { type:"multi", status:"waiting_play" } (배지 없음)
//        실제 .mp4 재생 요청  → status="captured" 승격 + GET 배지
//      [단일: chapter.xml 부재]
//        LMS 도메인의 .mp4 단독 요청 → 즉시
//        { type:"single", status:"captured", videoUrl, partCount:1 } + GET 배지
//        (어떤 파일명의 단독 MP4 강의도 놓치지 않음)
//
//   [결정적 사실] Chrome MV3 스펙상 Service Worker 의 fetch·chrome.downloads
//   요청은 initiator 권한 제약으로 DNR modifyHeaders(Referer/CORS 주입)가
//   적용되지 않는다.
//     - SW fetch(chapter.xml)  → Referer 누락 → 1704B 에러 HTML(200 OK) 수신
//     - chrome.downloads.download → Referer 누락 → Failed - Forbidden
//   따라서 아래 원래 성공 모델로 복귀한다:
//     - chapter.xml 파싱: LMS 탭(동일 출처) fetch + 세션 쿠키 인증
//       (cURL 확정: https://kucom.korea.ac.kr/.../contents/web_files/chapter.xml)
//     - 다운로드 실행  : 탭 내 투명 iframe 순차 주입 + DNR Content-Disposition(Rule 1)
// ============================================================================

// ----------------------------------------------------------------------------
// 0. 전역 상수
// ----------------------------------------------------------------------------
const SINGLE_RULE_ID = 1;          // 단일 영상(single) 다운로드 룰 ID
const KUCOM_CORS_RULE_ID = 2;      // [보조] kucom chapter.xml CORS 우회 룰 ID
const PART_RULE_ID_BASE = 100;     // Rule 1 계열: 멀티 파트별 다운로드 룰 시작 ID
const REFERER_VALUE = "https://kucom.korea.ac.kr/";
const IFRAME_INTERVAL_MS = 1000;   // iframe 주입 간격 (제스처 소진/Silent Drop 회피)
const IFRAME_LIFETIME_MS = 5000;   // iframe DOM 잔존 수명 (주입 후 자동 제거)
const BADGE_RESET_MS = 3000;       // 완료(OK) 배지 표시 후 초기화 시간

// 상태 라이프사이클
//   type   : multi(분할 챕터) | single(단독 MP4)
//   status : waiting_play(메타데이터만 확보·재생 대기) | captured(포착 완료)
const TYPE_MULTI = "multi";
const TYPE_SINGLE = "single";
const STATUS_WAITING_PLAY = "waiting_play";
const STATUS_CAPTURED = "captured";

// ----------------------------------------------------------------------------
// 0-1. 세션 단위 상태 SSOT (chrome.storage.session)
//
//   [설계] 탭 단일 전역 변수를 폐기하고 `${tabId}:${contentKey}` 세션 단위로 관리.
//     - 세션 저장소 키 : `sess_${tabId}_${contentKey}`
//     - 탭 활성 인덱스 : `idx_${tabId}` = { activeContentKey, generations }
//     - 팝업 뷰 스냅샷: `tab_${tabId}` (popup.js 하위 호환)
//
//   세션 상태 스키마:
//   {
//     tabId, contentKey, generation,
//     chapterUrl, chapterStatus,          // unknown|found|valid|invalid
//     chapterStoryIds, chapterPartUrls,   // story_idref 및 파생 main_*.mp4 URL
//     liveMediaUrl, liveMediaConfidence,  // none|candidate|verified|rejected
//     lastMediaSeenAt, downloadPlan,      // none|single|multipart
//     planReason, downloadStarted,
//     status, title, partCount, downloadStatus
//   }
//
//   [핵심 불변식]
//     downloadable = (validMultipartChapterPlan) OR (verifiedLiveMediaUrl)
//     chapter.xml 이벤트는 liveMedia* 를, live MP4 이벤트는 chapterPartUrls 를
//     절대 초기화하지 않는다. (둘은 병합)
// ----------------------------------------------------------------------------
const SESS_PREFIX = "sess_";
const IDX_PREFIX = "idx_";
const TAB_STATE_PREFIX = "tab_"; // 팝업 뷰 스냅샷 전용

// 자동 다운로드 후보에서 제외할 보조 영상 파일명
const EXCLUDED_MEDIA_NAMES = [
  "preloader.mp4", "intro.mp4", "preview.mp4",
  "thumbnail.mp4", "poster.mp4", "loading.mp4"
];

function tabStateKey(tabId) { return TAB_STATE_PREFIX + tabId; }
function sessKey(tabId, contentKey) { return SESS_PREFIX + tabId + "_" + contentKey; }
function idxKey(tabId) { return IDX_PREFIX + tabId; }

function sessionTag(s) {
  return "[session tabId:" + s.tabId + " content:" + s.contentKey + " gen:" + s.generation + "]";
}
function logSession(s, event, extra) {
  console.log(sessionTag(s) + " " + event + (extra ? " " + extra : ""));
}

// contentKey 추출:
//   /contents7/{tenant}/{contentKey}/...  /  /em/{contentKey}
//   chapter.xml / screen.mp4 / ssmovie.mp4 / main_{uuid}.mp4 URL 모두 커버.
//   query(?_=cachebust)는 contentKey 에 포함하지 않는다.
function contentKeyFromUrl(url) {
  if (!url) return null;
  const clean = String(url).split(/[?#]/)[0];
  let m = clean.match(/\/contents\d*\/([^\/]+)\/([^\/]+)\//i);
  if (m && m[2].toLowerCase() !== "contents") return m[2];
  m = clean.match(/\/em\/([^\/?#]+)/i);
  if (m) return m[1];
  return null;
}

function basenameOf(url) {
  return String(url || "").split(/[?#]/)[0].split("/").pop().toLowerCase();
}

// 본편 단일/파트 후보 파일명 (chapter_valid multipart · single fallback)
function isPrimaryMediaName(name) {
  return name === "screen.mp4" || name === "ssmovie.mp4" ||
    /^main_[^\/]+\.mp4$/i.test(name);
}

// CDN/LMS URL 의 ".../contents/" 직전까지를 media base 로 유도한다.
//   video URL  → https://<cdn>/contents7/.../contents/
//   chapterUrl → https://kucom.korea.ac.kr/contents7/.../contents/
function mediaBaseFromUrl(url) {
  if (!url) return null;
  const m = String(url).match(/(\/contents\d*\/[^\/]+\/[^\/]+\/contents\/)/i);
  if (!m) return null;
  const origin = String(url).match(/^(https?:\/\/[^\/]+)/i);
  return (origin ? origin[1] : "") + m[1];
}

function newSession(tabId, contentKey, generation) {
  return {
    tabId: tabId,
    contentKey: contentKey,
    generation: generation,
    chapterUrl: null,
    chapterStatus: "unknown",
    chapterStoryIds: [],
    chapterPartUrls: [],
    liveMediaUrl: null,
    liveMediaConfidence: "none",
    lastMediaSeenAt: null,
    downloadPlan: "none",
    planReason: "none",
    downloadStarted: false,
    status: STATUS_WAITING_PLAY,
    title: null,
    partCount: null,
    downloadStatus: null
  };
}

async function readIndex(tabId) {
  try {
    const k = idxKey(tabId);
    return (await chrome.storage.session.get(k))[k] ||
      { activeContentKey: null, generations: {} };
  } catch (e) {
    return { activeContentKey: null, generations: {} };
  }
}
async function writeIndex(tabId, idx) {
  try { await chrome.storage.session.set({ [idxKey(tabId)]: idx }); } catch (e) {}
}
async function readSession(tabId, contentKey) {
  try {
    const k = sessKey(tabId, contentKey);
    return (await chrome.storage.session.get(k))[k] || null;
  } catch (e) {
    return null;
  }
}
async function writeSession(s) {
  try { await chrome.storage.session.set({ [sessKey(s.tabId, s.contentKey)]: s }); } catch (e) {}
}

// 한 세션에 대한 read-modify-write 를 직렬화한다.
//   async await 사이에 끼어든 다른 이벤트가 stale state 를 다시 저장하는
//   race condition 을 차단한다.
const _sessionLocks = new Map();
function withSessionLock(key, task) {
  const prev = _sessionLocks.get(key) || Promise.resolve();
  const run = prev.then(task, task);
  _sessionLocks.set(key, run.catch(() => {}));
  return run;
}

async function mutateSession(tabId, contentKey, mutator, expectedGeneration) {
  const key = sessKey(tabId, contentKey);
  return withSessionLock(key, async () => {
    const s = await readSession(tabId, contentKey);
    if (!s) return null;
    // await 이후 generation 이 바뀌었으면 stale → 쓰기 금지
    if (expectedGeneration !== undefined && s.generation !== expectedGeneration) {
      return null;
    }
    const next = mutator({ ...s }) || s;
    await writeSession(next);
    await publishView(tabId, next);
    return next;
  });
}

// contentKey 최초 진입 또는 전환 시에만 새 generation 발급.
//   동일 contentKey 의 cache-busting query 변경은 여기서 새 세션을 만들지 않는다.
async function ensureSession(tabId, contentKey) {
  const idx = await readIndex(tabId);
  let isNewGeneration = false;
  if (idx.activeContentKey !== contentKey) {
    idx.generations[contentKey] = (idx.generations[contentKey] || 0) + 1;
    idx.activeContentKey = contentKey;
    isNewGeneration = true;
    await writeIndex(tabId, idx);
  }
  const generation = idx.generations[contentKey] || 1;
  let s = await readSession(tabId, contentKey);
  if (!s || s.generation !== generation) {
    // 이전 콘텐츠 상태 폐기(stale) → 새 세션으로 대체
    s = newSession(tabId, contentKey, generation);
    await writeSession(s);
    if (isNewGeneration) clearBadge(tabId);
  }
  return { session: s, generation: generation };
}

async function getActiveSession(tabId) {
  const idx = await readIndex(tabId);
  if (!idx.activeContentKey) return null;
  return await readSession(tabId, idx.activeContentKey);
}

// ---- 하위 호환 래퍼 (기존 코드/팝업이 사용) ----
async function getTabState(tabId) {
  const s = await getActiveSession(tabId);
  return s || newSession(tabId, null, 0);
}
async function patchTabState(tabId, patch) {
  const idx = await readIndex(tabId);
  if (!idx.activeContentKey) return await getTabState(tabId);
  return await mutateSession(tabId, idx.activeContentKey, (s) => ({ ...s, ...patch }));
}

// 팝업 뷰 스냅샷 — popup.js 가 chrome.storage.session 에서 직접 읽는다.
async function publishView(tabId, s) {
  const type = s.downloadPlan === "multipart"
    ? TYPE_MULTI
    : (s.downloadPlan === "single"
        ? TYPE_SINGLE
        : (s.chapterStatus !== "unknown" ? TYPE_MULTI : TYPE_SINGLE));
  const partCount = s.downloadPlan === "multipart"
    ? s.chapterStoryIds.length
    : (s.liveMediaConfidence === "verified" ? 1 : null);
  const view = {
    type: type,
    status: s.status,
    title: s.title,
    xmlUrl: s.chapterUrl,
    videoUrl: s.liveMediaUrl,
    partCount: partCount,
    plan: s.downloadPlan,
    planReason: s.planReason,
    contentKey: s.contentKey,
    generation: s.generation,
    downloadStatus: s.downloadStatus
  };
  try { await chrome.storage.session.set({ [tabStateKey(tabId)]: view }); } catch (e) {}
}

// 주 프레임 실이동·새로고침 시에만 호출: 활성 인덱스 + 뷰 + 배지 초기화.
//   이전 세대 정보는 generations 에 보존하되 active 를 비운다.
//   navigationAt 타임스탬프로 내비게이션 이전에 발생한 late 요청을 차단한다.
async function resetTabState(tabId) {
  const prev = await readIndex(tabId);
  await writeIndex(tabId, {
    activeContentKey: null,
    generations: prev.generations || {},
    navigationAt: Date.now()
  });
  try { await chrome.storage.session.remove(tabStateKey(tabId)); } catch (e) {}
  clearBadge(tabId);
}

// ----------------------------------------------------------------------------
// 배지 설정 헬퍼 (오직 tabId 스코프)
//   chrome.action.setBadgeText({ text, tabId }) 는 tabId 를 명시하면
//   SW Inactive 여부와 무관하게 브라우저가 탭별로 배지를 네이티브 보존한다.
// ----------------------------------------------------------------------------
function setBadge(tabId, text, color) {
  try {
    chrome.action.setBadgeText({ tabId: tabId, text: text });
    if (color) {
      chrome.action.setBadgeBackgroundColor({ tabId: tabId, color: color });
    }
  } catch (e) {
    // 탭이 이미 닫힌 경우 등 — 무시
  }
}

function clearBadge(tabId) {
  try {
    chrome.action.setBadgeText({ tabId: tabId, text: "" });
  } catch (e) {
    // 탭이 이미 닫힌 경우 등 — 무시
  }
}

// 실제 영상 스트림(.mp4 본문) 여부 판별
//   - 쿼리스트링(?token=..., &_=ts) 이 붙어도 본문 경로 기준으로 판별한다.
//   - 분할 강의(main_*.mp4), 단독 MP4(ssmovie.mp4 / screen.mp4 / 그 외 어떤
//     파일명의 .mp4) 를 모두 커버한다. → chapter.xml 이 없는 단일 영상 미인식
//     버그 해결: 파일명 서브스트링 제약을 두지 않고 LMS 도메인에서 나가는
//     모든 `.mp4` 요청을 영상 스트림으로 간주한다.
function isVideoStreamUrl(url) {
  const path = (url || "").split(/[?#]/)[0].toLowerCase();
  return path.endsWith(".mp4");
}

// 포착된 비디오 URL에서 LMS 본진 서버의 chapter.xml 절대 경로를 역산(Derive)한다.
// cURL 확정 데이터:
//   플레이어 실제 호출:
//     https://kucom.korea.ac.kr/contents7/kruniv1001/6ab13ac733ea5/contents/web_files/chapter.xml?_=ts
//   → 비디오 URL 경로에서 "(/contents\d*/.../contents/)" 구간을 뜯어내고
//     도메인을 https://kucom.korea.ac.kr 로 치환한 뒤 "web_files/chapter.xml" 을 결합.
function deriveTargetXmlUrl(videoUrl) {
  if (!videoUrl) return null;
  const match = videoUrl.match(/(\/contents\d*\/[^\/]+\/[^\/]+\/contents\/)/i);
  if (match) {
    return "https://kucom.korea.ac.kr" + match[1] + "web_files/chapter.xml";
  }
  return null;
}

// ----------------------------------------------------------------------------
// 0-2. [보조] kucom chapter.xml CORS 우회 룰 확보
//   최상위 프레임(kulms)에서 kucom 서브도메인을 fetch 하는 Cross-Origin
//   "Failed to fetch" 대비: chapter.xml 응답에 ACAO:* + ACAC:true 를 주입한다.
//   (동일 출처 kucom 프레임을 발견해 그 안에서 실행되면 이 룰은 쓰이지 않는다)
// ----------------------------------------------------------------------------
async function ensureKucomCorsRule() {
  let currentRules = [];
  try {
    currentRules = await chrome.declarativeNetRequest.getDynamicRules();
  } catch (e) {
    currentRules = [];
  }

  // 기존 id 2 를 정리하고 재등록 (중복 ID 방지)
  const removeRuleIds = currentRules
    .filter((r) => r.id === KUCOM_CORS_RULE_ID)
    .map((r) => r.id);

  await chrome.declarativeNetRequest.updateDynamicRules({
    removeRuleIds: removeRuleIds,
    addRules: [
      {
        id: KUCOM_CORS_RULE_ID,
        priority: 3,
        action: {
          type: "modifyHeaders",
          responseHeaders: [
            { header: "Access-Control-Allow-Origin", operation: "set", value: "*" },
            { header: "Access-Control-Allow-Credentials", operation: "set", value: "true" }
          ]
        },
        condition: {
          urlFilter: "*kucom.korea.ac.kr*chapter.xml*",
          resourceTypes: ["xmlhttprequest"]
        }
      }
    ]
  });
  console.log("[LMS Helper] kucom CORS 우회 룰 확보 (id:", KUCOM_CORS_RULE_ID + ")");
}

// ----------------------------------------------------------------------------
// 0-4. DNR Rule 1 계열 (파트별 다운로드 강제화) 원자적 등록
//   IFrame(sub_frame) 요청에 Referer + Content-Disposition: attachment 를 주입한다.
//   파트별 고유 토큰(lms_dl=p01..pNN)으로 룰을 분리하여
//   각 파트가 자기 파일명을 받도록 한다. (동일 폭 제로패딩 → substring 충돌 방지)
// ----------------------------------------------------------------------------
async function clearAndSetPartRules(targets) {
  // [ID 충돌 해결] "Rule with id 100 does not have a unique ID" 방지!
  //   다운로드 룰(1, 100+)만 정리하고 CORS 보조 룰(2)은 보존한다.
  let currentRules = [];
  try {
    currentRules = await chrome.declarativeNetRequest.getDynamicRules();
  } catch (e) {
    currentRules = [];
  }
  const removeRuleIds = currentRules
    .filter((r) => r.id !== KUCOM_CORS_RULE_ID)
    .map((r) => r.id);

  const addRules = targets.map((t) => ({
    id: t.ruleId,
    priority: 1,
    action: {
      type: "modifyHeaders",
      requestHeaders: [
        { header: "Referer", operation: "set", value: REFERER_VALUE }
      ],
      responseHeaders: [
        {
          header: "Content-Disposition",
          operation: "set",
          value: 'attachment; filename="' + t.fileName + '"'
        }
      ]
    },
    condition: {
      urlFilter: "*" + t.ruleToken + "*",
      resourceTypes: ["sub_frame"]
    }
  }));

  await chrome.declarativeNetRequest.updateDynamicRules({
    removeRuleIds: removeRuleIds,
    addRules: addRules
  });
  console.log("[LMS Helper] 다운로드 룰 원자적 등록 완료 — 룰 수:", addRules.length);
}

// ----------------------------------------------------------------------------
// 1. 네트워크 관찰 (webRequest) — 세션(contentKey) 단위 병합 감지
//
//   [병합 원칙]
//     - chapter.xml 이벤트: chapter* 만 갱신. liveMediaUrl/liveMediaConfidence 유지.
//     - live .mp4 이벤트 : liveMedia* 만 갱신. 이미 파싱한 chapterPartUrls 유지.
//     - downloadable = validMultipartChapterPlan OR verifiedLiveMediaUrl
//
//   [본편 후보]  screen.mp4 / ssmovie.mp4 / main_{id}.mp4
//     → contentKey 일치 + 제외 목록(preloader 등) 아님 → verified
//   [그 외 mp4]  contentKey 일치해도 자동 다운로드 대상으로 쓰지 않음(ignored)
// ----------------------------------------------------------------------------
chrome.webRequest.onBeforeRequest.addListener(
  async (details) => {
    // [가드] 우리가 유발한 iframe 다운로드 트래픽은 재포착하지 않는다
    if (details.url.includes("lms_dl=")) return;
    if (details.tabId < 0) return;

    const tabId = details.tabId;
    const url = details.url;

    // [stale 가드] 주 프레임 내비게이션 이전에 발생한 late 요청은 버린다.
    //   (같은 탭에서 강의 A → B 이동 후 A 의 늦은 mp4/chapter 가 B 를 덮는 문제)
    const idx0 = await readIndex(tabId);
    if (details.timeStamp && idx0.navigationAt && details.timeStamp < idx0.navigationAt) {
      return;
    }

    // ---- [chapter.xml] optional metadata — live 상태를 초기화하지 않는다 ----
    if (url.includes("chapter.xml")) {
      const contentKey = contentKeyFromUrl(url);
      if (!contentKey) return;
      // out-of-order 로 늦게 도착한 이전 콘텐츠 이벤트가 새 콘텐츠를 덮지 않게.
      const activeCh = await getActiveSession(tabId);
      if (activeCh && activeCh.contentKey !== contentKey && activeCh.lastMediaSeenAt &&
          (details.timeStamp || Date.now()) < activeCh.lastMediaSeenAt) {
        return;
      }
      const { session, generation } = await ensureSession(tabId, contentKey);
      logSession({ ...session, generation: generation }, "CHAPTER_FOUND");
      await mutateSession(tabId, contentKey, (s) => {
        s.chapterUrl = url;
        // 이미 valid 면 유지 (재파싱 결과가 invalid 라도 기존 파트를 보존)
        if (s.chapterStatus !== "valid") s.chapterStatus = "found";
        s.downloadStatus = null;
        return s;
      }, generation);
      // 파싱은 비동기·generation 가드 하에 (stale 결과는 쓰지 않음)
      void parseAndApplyChapter(tabId, contentKey, generation, url);
      return;
    }

    if (!isVideoStreamUrl(url)) return;

    const contentKey = contentKeyFromUrl(url);
    if (!contentKey) return; // contentKey 불명 mp4 는 자동 후보로 쓰지 않음

    const name = basenameOf(url);
    const excluded = EXCLUDED_MEDIA_NAMES.includes(name);
    const primary = !excluded && isPrimaryMediaName(name);

    // ---- 비본편(보조/기타 mp4): 현재 활성 세션 contentKey 와 일치할 때만 반영 ----
    //   (preloader 가 먼저 와서 새 세션을 점유하는 것을 방지)
    if (!primary) {
      const idx = await readIndex(tabId);
      if (idx.activeContentKey !== contentKey) return;
      const { generation } = await ensureSession(tabId, contentKey);
      await mutateSession(tabId, contentKey, (s) => {
        s.lastMediaSeenAt = Date.now();
        if (excluded) {
          logSession(s, "LIVE_MEDIA_REJECTED", name + " (excluded)");
          if (s.liveMediaConfidence !== "verified") s.liveMediaConfidence = "rejected";
        } else {
          logSession(s, "LIVE_MEDIA_IGNORED", name + " (not_primary)");
          if (s.liveMediaConfidence === "none") s.liveMediaConfidence = "candidate";
        }
        return s;
      }, generation);
      return;
    }

    // ---- 본편 후보: screen.mp4 / ssmovie.mp4 / main_*.mp4 ----
    //   out-of-order 로 늦게 도착한 이전 콘텐츠 요청이 새 콘텐츠를 덮지 않게.
    const activeMain = await getActiveSession(tabId);
    if (activeMain && activeMain.contentKey !== contentKey && activeMain.lastMediaSeenAt &&
        (details.timeStamp || Date.now()) < activeMain.lastMediaSeenAt) {
      return;
    }
    const { session, generation } = await ensureSession(tabId, contentKey);
    const merged = await mutateSession(tabId, contentKey, (s) => {
      s.liveMediaUrl = url;
      s.liveMediaConfidence = "verified";
      s.lastMediaSeenAt = details.timeStamp || Date.now();
      s.downloadStatus = null;
      // chapterPartUrls 는 절대 지우지 않는다. 비어 있으면 지금 base 로 보강.
      if (s.chapterStoryIds.length > 0 && s.chapterPartUrls.length === 0) {
        const base = mediaBaseFromUrl(s.liveMediaUrl) || mediaBaseFromUrl(s.chapterUrl);
        if (base) {
          s.chapterPartUrls = s.chapterStoryIds.map(
            (id) => base + "media_files/main_" + id + ".mp4"
          );
        }
      }
      return s;
    }, generation);
    logSession(merged || { ...session, generation: generation }, "LIVE_MEDIA_VERIFIED", name);
    await recomputePlan(tabId, contentKey, generation);
  },
  { urls: ["*://*.gov-ntruss.com/*", "*://*.korea.ac.kr/*"] }
);

// ----------------------------------------------------------------------------
// 1-0. chapter.xml 파싱 + 다운로드 계획 선택
// ----------------------------------------------------------------------------

// 챕터 XML 을 동일 출처(kucom) 프레임에서 fetch 하여 story_idref 를 추출한다.
async function probeChapterXml(tabId, xmlUrl) {
  if (!xmlUrl) return { ok: false, reason: "xml_url_missing", storyIds: [], title: null };
  await ensureKucomCorsRule();

  let parseTarget = { frameIds: [0] };
  try {
    const frames = await chrome.webNavigation.getAllFrames({ tabId: tabId });
    const kucomFrame = frames.find((f) => f.url && f.url.includes("kucom.korea.ac.kr"));
    if (kucomFrame) parseTarget = { frameIds: [kucomFrame.frameId] };
  } catch (e) {
    // 프레임 조회 실패 → 최상위 프레임 폴백
  }

  try {
    const [result] = await chrome.scripting.executeScript({
      target: { tabId: tabId, ...parseTarget },
      func: async (xmlUrl) => {
        const title = document.title || "";
        try {
          const res = await fetch(xmlUrl, {
            credentials: "include",
            headers: {
              "Accept": "application/xml, text/xml, */*; q=0.01",
              "X-Requested-With": "XMLHttpRequest"
            }
          });
          const xmlText = await res.text();
          const storyIds = [...xmlText.matchAll(/story_idref\s*=\s*["']([^"']+)["']/g)]
            .map((m) => m[1]);
          const htmlTitle = xmlText.match(/<title[^>]*>([^<]+)<\/title>/i)?.[1]?.trim() || "";
          const textSnippet = xmlText
            .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "")
            .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, "")
            .replace(/<[^>]+>/g, " ")
            .replace(/\s+/g, " ")
            .trim()
            .slice(0, 100);
          return {
            ok: true,
            storyIds: storyIds,
            title: title,
            preview: xmlText.slice(0, 150),
            htmlTitle: htmlTitle,
            textSnippet: textSnippet
          };
        } catch (err) {
          return {
            ok: false,
            reason: String(err && err.message ? err.message : err),
            storyIds: [],
            title: title
          };
        }
      },
      args: [xmlUrl]
    });
    return (result && result.result) || { ok: false, reason: "no_result", storyIds: [], title: null };
  } catch (e) {
    return { ok: false, reason: String(e && e.message ? e.message : e), storyIds: [], title: null };
  }
}

// 파싱 결과를 세션에 병합 (generation 불일치면 무시).
//   story_idref 1개 이상 → chapterStatus=valid + multipart 파트 URL 구성.
//   비어 있으면 invalid 처리하되 liveMedia* 는 건드리지 않는다.
async function parseAndApplyChapter(tabId, contentKey, generation, xmlUrl) {
  const probed = await probeChapterXml(tabId, xmlUrl);
  const merged = await mutateSession(tabId, contentKey, (s) => {
    if (!probed.ok || !probed.storyIds || probed.storyIds.length === 0) {
      // 이미 valid 하게 파싱된 파트가 있으면 일시적 재파싱 실패로 덮지 않는다.
      if (s.chapterStatus !== "valid") {
        s.chapterStatus = "invalid";
        s.chapterStoryIds = [];
      }
    } else {
      s.chapterStatus = "valid";
      s.chapterStoryIds = probed.storyIds;
      // liveMediaUrl 이 없어도 chapterUrl 기반 base 로 multipart URL 을 구성한다.
      const base = mediaBaseFromUrl(s.liveMediaUrl) || mediaBaseFromUrl(s.chapterUrl);
      if (base) {
        s.chapterPartUrls = probed.storyIds.map(
          (id) => base + "media_files/main_" + id + ".mp4"
        );
      }
    }
    if (probed.title && !s.title) s.title = probed.title;
    s.downloadStatus = null;
    return s;
  }, generation);
  if (!merged) return; // stale generation → 폐기

  if (probed.ok && probed.preview !== undefined) {
    console.log("[LMS Helper] XML 수신 본문 미리보기:", probed.preview);
    console.log(
      "[LMS Helper] 수신 응답 제목:", probed.htmlTitle || "(N/A)",
      "| 내용 요약:", probed.textSnippet || "(N/A)"
    );
  }
  if (merged.chapterStatus === "valid") {
    logSession(merged, "CHAPTER_VALID", "parts=" + merged.chapterStoryIds.length);
  } else {
    logSession(merged, "CHAPTER_INVALID", "reason=" + (probed.reason || "no_story_idref"));
  }
  await recomputePlan(tabId, contentKey, generation);
}

// downloadable = validMultipartChapterPlan OR verifiedLiveMediaUrl
//   두 신호를 병합해 plan 을 선택하고 배지/상태를 결정한다.
async function recomputePlan(tabId, contentKey, generation) {
  const s = await mutateSession(tabId, contentKey, (cur) => {
    let plan = "none";
    let reason = "none";

    if (cur.chapterStatus === "valid" && cur.chapterStoryIds.length > 0) {
      plan = "multipart";
      reason = "chapter_valid";
      if (cur.chapterPartUrls.length === 0) {
        const base = mediaBaseFromUrl(cur.liveMediaUrl) || mediaBaseFromUrl(cur.chapterUrl);
        if (base) {
          cur.chapterPartUrls = cur.chapterStoryIds.map(
            (id) => base + "media_files/main_" + id + ".mp4"
          );
        }
      }
    } else if (cur.liveMediaConfidence === "verified") {
      plan = "single";
      reason = cur.chapterStatus === "invalid"
        ? "chapter_invalid_live_verified"
        : "chapter_missing_live_verified";
    } else {
      plan = "none";
      reason = cur.chapterStatus === "found" ? "chapter_found_awaiting" : "waiting_live";
    }

    cur.downloadPlan = plan;
    cur.planReason = reason;
    cur.status = plan === "none" ? STATUS_WAITING_PLAY : STATUS_CAPTURED;
    cur.partCount = plan === "multipart"
      ? cur.chapterStoryIds.length
      : (cur.liveMediaConfidence === "verified" ? 1 : null);
    return cur;
  }, generation);
  if (!s) return;

  if (s.downloadPlan === "multipart") {
    logSession(s, "PLAN_SELECTED", "multipart parts=" + s.chapterStoryIds.length + " reason=" + s.planReason);
    setBadge(tabId, "GET", "#4CAF50");
  } else if (s.downloadPlan === "single") {
    logSession(s, "PLAN_SELECTED", "single url=" + basenameOf(s.liveMediaUrl) + " reason=" + s.planReason);
    setBadge(tabId, "GET", "#4CAF50");
  } else {
    logSession(s, "PLAN_PENDING", s.planReason);
  }
}


// ----------------------------------------------------------------------------
// 1-1. 배지·상태 초기화 (엄격 제한)
//   오직 chrome.webNavigation.onBeforeNavigate 에서
//     - details.frameId === 0  (최상위 메인 프레임)
//     - details.tabId >= 0
//     - http(s) 실 URL
//   조건을 모두 만족하는 '실제 LMS 페이지 이동/새로고침'에서만 해당 탭을 리셋.
//
//   [철저한 가드]
//   - 투명 iframe 주입(sub_frame)     → frameId 1+ → 제외
//   - 내부 API ping (XHR/fetch)        → 내비게이션 이벤트 없음 → 제외(자동)
//   - chrome-extension://, about:, data: → http(s) 가드로 제외
//   - tabs.onActivated / 포커스 리스너는 배지를 덮어쓸 수 있으므로 사용하지 않음
// ----------------------------------------------------------------------------
chrome.webNavigation.onBeforeNavigate.addListener(
  (details) => {
    if (details.frameId !== 0) return;                     // 주 프레임 전환/새로고침만
    if (details.tabId < 0) return;
    if (!/^https?:\/\//i.test(details.url)) return;        // 진짜 페이지 URL 만

    console.log(
      "[LMS Helper] 주 프레임 이동/새로고침 → 배지·상태 초기화 (tab:",
      details.tabId + ", url:", details.url + ")"
    );
    void resetTabState(details.tabId);
  },
  { url: [{ hostSuffix: "korea.ac.kr" }, { hostSuffix: "gov-ntruss.com" }] }
);

// ----------------------------------------------------------------------------
// 1-2. 플레이어 실제 요청 헤더 스니퍼 (디버깅용)
//   플레이어가 chapter.xml을 정상 호출할 때 보내는 진짜 Referer를 확인한다.
//   (requestHeaders는 [{name, value}, ...] 배열 형태 → find()로 탐색)
// ----------------------------------------------------------------------------
chrome.webRequest.onSendHeaders.addListener(
  (details) => {
    if (details.url.includes("chapter.xml") && !details.url.includes("lms_dl=")) {
      // requestHeaders는 [{name, value}, ...] 배열 형태 — find()로 정상 탐색
      const headersList = details.requestHeaders || [];
      const ref =
        headersList.find((h) => h.name.toLowerCase() === "referer")?.value ||
        "(없음)";
      const orig =
        headersList.find((h) => h.name.toLowerCase() === "origin")?.value ||
        "(없음)";
      console.log(
        "[LMS Helper] 📡 chapter.xml 요청 헤더 — Referer: [" + ref +
          "] | Origin: [" + orig + "]"
      );
    }
  },
  { urls: ["*://*.gov-ntruss.com/*", "*://*.korea.ac.kr/*"] },
  ["requestHeaders", "extraHeaders"]
);

// ----------------------------------------------------------------------------
// 2. 팝업(popup.js)과의 통신 리스너
//    - CHECK_STATUS  : 세션 SSOT 상태를 즉시 응답. captured 면 강의명·파트 수를
//                      resolveMediaInfo() 로 지연 확정하여 함께 전달.
//    - START_DOWNLOAD: type 에 따라 멀티/단일 다운로드 파이프라인으로 분기.
// ----------------------------------------------------------------------------

// 세션의 확정 정보를 반환한다 (별도 네트워크 조회 없음 — 이미 병합된 세션 사용).
async function resolveMediaInfo(tabId) {
  const st = await getTabState(tabId);
  const type = st.downloadPlan === "multipart"
    ? TYPE_MULTI
    : (st.downloadPlan === "single"
        ? TYPE_SINGLE
        : (st.chapterStatus !== "unknown" ? TYPE_MULTI : TYPE_SINGLE));
  const partCount = st.downloadPlan === "multipart"
    ? st.chapterStoryIds.length
    : (st.liveMediaConfidence === "verified" ? 1 : (st.partCount || null));
  return {
    title: st.title,
    partCount: partCount,
    type: type,
    status: st.status,
    plan: st.downloadPlan,
    planReason: st.planReason
  };
}

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
  // [탭 범위 회귀] 팝업이 명시한 tabId 를 우선, 없으면 발신 탭으로 폴백
  const tabId = message.tabId !== undefined ? message.tabId : sender.tab && sender.tab.id;
  if (tabId === undefined || tabId < 0) return;

  if (message.action === "CHECK_STATUS") {
    void (async () => {
      const active = await getActiveSession(tabId);
      if (!active) {
        sendResponse({ type: null, status: null, plan: null });
        return;
      }
      const st = active;
      const info = await resolveMediaInfo(tabId);
      const resp = {
        type: info.type,
        status: info.status,
        title: info.title || st.title,
        xmlUrl: st.chapterUrl,
        videoUrl: st.liveMediaUrl,
        partCount: info.partCount,
        plan: st.downloadPlan,
        planReason: st.planReason,
        contentKey: st.contentKey,
        generation: st.generation,
        downloadStatus: st.downloadStatus
      };
      sendResponse(resp);
    })();
    return true;
  }

  if (message.action === "START_DOWNLOAD") {
    void executeDownload(tabId);
    return; // 응답 대기 없음 → 다운로드 진행은 DOWNLOAD_* 브로드캐스트로 통지
  }
});

// ============================================================================
// 3. 다운로드 디스패처
//   downloadable = validMultipartChapterPlan OR verifiedLiveMediaUrl
// ============================================================================
async function executeDownload(tabId) {
  const st = await getTabState(tabId);

  if (!st || !st.contentKey) {
    return { ok: false, reason: "no_media" };
  }

  const validMultipart = st.chapterStatus === "valid" && st.chapterStoryIds.length > 0;
  const verifiedLive = st.liveMediaConfidence === "verified" && !!st.liveMediaUrl;

  if (!validMultipart && !verifiedLive) {
    // chapter/live 둘 다 없을 때만 보류 (한쪽만으로도 진행 가능)
    logSession(st, "DOWNLOAD_HOLD", "reason=" + st.planReason);
    return { ok: false, reason: "waiting_play" };
  }

  await patchTabState(tabId, { downloadStarted: true });

  if (validMultipart) return executeMultiDownload(tabId, st);
  return executeSingleDownload(tabId, st);
}

// ============================================================================
// 4. 멀티 파트 다운로드 (chapter.xml 기반 분할 강의)
//    A. kucom 동일 출처 프레임/탭에서 chapter.xml fetch + 파싱 (SW 직접 fetch 금지)
//    B. 파트별 URL/파일명/토큰 타깃 구축 (URL 인덱스 배열)
//    C. DNR 룰 원자적 등록 (clearAndSetPartRules — ID 충돌 방지)
//    D. 탭 내 투명 iframe을 1000ms 간격으로 순차 주입 → 네이티브 다운로드
//    E. 완료 배지 및 상태 정리
// ============================================================================
async function executeMultiDownload(tabId, st) {
  const contentKey = st.contentKey;
  const capturedXmlUrl = st.chapterUrl || null;
  const capturedVideoUrl = st.liveMediaUrl || null;

  if (!capturedXmlUrl && !capturedVideoUrl) {
    return { ok: false, reason: "no_media" };
  }

  try {
    let partUrls = Array.isArray(st.chapterPartUrls) ? st.chapterPartUrls.slice() : [];
    let storyIds = Array.isArray(st.chapterStoryIds) ? st.chapterStoryIds.slice() : [];

    // 파트 URL 미구성 시 chapter.xml 재파싱 (동일 출처 프레임)
    if (partUrls.length === 0 || storyIds.length === 0) {
      const targetXmlUrl = capturedXmlUrl || deriveTargetXmlUrl(capturedVideoUrl);
      if (targetXmlUrl) {
        const probed = await probeChapterXml(tabId, targetXmlUrl);
        if (probed.ok && probed.storyIds && probed.storyIds.length > 0) {
          storyIds = probed.storyIds;
          const base = mediaBaseFromUrl(capturedVideoUrl) || mediaBaseFromUrl(targetXmlUrl);
          if (base) {
            partUrls = storyIds.map((id) => base + "media_files/main_" + id + ".mp4");
          }
          await mutateSession(tabId, contentKey, (s) => {
            s.chapterStatus = "valid";
            s.chapterStoryIds = storyIds;
            if (partUrls.length) s.chapterPartUrls = partUrls;
            return s;
          }, st.generation);
        } else {
          await mutateSession(tabId, contentKey, (s) => {
            s.chapterStatus = "invalid";
            s.chapterStoryIds = [];
            return s;
          }, st.generation);
        }
      } else {
        console.error(
          "[LMS Helper] ⚠️ chapter.xml URL 없음, 단일 영상으로 폴백"
        );
      }
    }

    // 강의명은 최상위 프레임(예: kulms.korea.ac.kr)에서 추출
    let topTitle = st.title || null;
    if (!topTitle) {
      try {
        const [topTitleResult] = await chrome.scripting.executeScript({
          target: { tabId: tabId, frameIds: [0] },
          func: () => document.title || "LMS_Lecture"
        });
        topTitle = (topTitleResult && topTitleResult.result) || "LMS_Lecture";
      } catch (e) {
        topTitle = "LMS_Lecture";
      }
    }

    if (partUrls.length > 0) {
      logSession(st, "DOWNLOAD_PLAN", "multipart parts=" + partUrls.length + " reason=chapter_valid");
    }

    const safeTitle = String(topTitle || "LMS_Lecture")
      .replace(/[\/\\?%*:|"<>]/g, "_").trim() || "LMS_Lecture";

    // ---- C. 타깃 결정 (URL + 파일명 + 고유 토큰) ----------------------
    //   토큰 제로패딩(고정 폭) 이유:
    //   urlFilter "*lms_dl=p1*"는 "lms_dl=p10"에도 매치되는 substring 문제 →
    //   동일 폭 코드(p01..pNN)로 룰 간 서로 substring이 되지 않게 한다.
    let targets;
    if (partUrls.length > 0) {
      const width = Math.max(2, String(partUrls.length).length);
      targets = partUrls.map((url, i) => {
        const fileName =
          partUrls.length === 1
            ? safeTitle + ".mp4"
            : safeTitle + "_Part" + (i + 1) + ".mp4";
        return {
          url: url,
          fileName: fileName,
          ruleToken: "lms_dl=p" + String(i + 1).padStart(width, "0"),
          ruleId: PART_RULE_ID_BASE + i
        };
      });
    } else if (capturedVideoUrl) {
      // XML 파싱 실패·부재 시 단일 영상 fallback: 강의명.mp4
      targets = [{
        url: capturedVideoUrl,
        fileName: safeTitle + ".mp4",
        ruleToken: "lms_dl=1",
        ruleId: SINGLE_RULE_ID
      }];
    } else {
      return { ok: false, reason: "no_target" }; // 유효한 다운로드 대상이 없는 경우
    }

    console.log("[LMS Helper] [멀티] 최종 다운로드 타깃 수:", targets.length);
    targets.forEach((t, i) =>
      console.log("  [" + (i + 1) + "] " + t.fileName + " ← " + t.url)
    );

    // ---- C. DNR 룰 원자적 등록 (기존 룰 전체 정리 → 고유 ID 재등록) ------
    await clearAndSetPartRules(targets);

    // ---- D. 탭 내 투명 iframe 순차 주입 --------------------------------
    await runIframeDownloadLoop(tabId, targets);

    // ---- E. 완료 배지 및 상태 정리 -------------------------------------
    return finalizeDownload(tabId, targets.length);
  } catch (error) {
    return handleDownloadError(tabId, error);
  }
}

// ============================================================================
// 5. 단일 영상 다운로드 (chapter.xml 없는 단독 MP4)
//    A. 단일 DNR 룰(SINGLE_RULE_ID) 등록
//    B. 1회 iframe 주입으로 네이티브 다운로드 인계
// ============================================================================
async function executeSingleDownload(tabId, st) {
  const videoUrl = st.liveMediaUrl || null;
  if (!videoUrl) {
    return { ok: false, reason: "no_video_url" };
  }

  try {
    // 강의명: 저장된 title 우선, 없으면 최상위 프레임에서 추출
    let safeTitle = String(st.title || "").replace(/[\/\\?%*:|"<>]/g, "_").trim();
    if (!safeTitle) {
      try {
        const [titleResult] = await chrome.scripting.executeScript({
          target: { tabId: tabId, frameIds: [0] },
          func: () => document.title || "LMS_Lecture"
        });
        safeTitle = String((titleResult && titleResult.result) || "LMS_Lecture")
          .replace(/[\/\\?%*:|"<>]/g, "_").trim() || "LMS_Lecture";
      } catch (e) {
        safeTitle = "LMS_Lecture";
      }
    }

    // 단일 영상: 룰 1개 + 토큰 lms_dl=1
    const targets = [{
      url: videoUrl,
      fileName: safeTitle + ".mp4",
      ruleToken: "lms_dl=1",
      ruleId: SINGLE_RULE_ID
    }];

    console.log("[LMS Helper] [단일] 다운로드 타깃 —", targets[0].fileName);
    console.log("  ", targets[0].url);

    await clearAndSetPartRules(targets);

    // 1회 iframe 주입 (누적 진행 브로드캐스트 포함)
    await runIframeDownloadLoop(tabId, targets);

    return finalizeDownload(tabId, targets.length);
  } catch (error) {
    return handleDownloadError(tabId, error);
  }
}

// ============================================================================
// 5-1. 투명 iframe 순차 주입 공용 루틴 (멀티 N회 / 단일 1회 공용)
//   chrome.downloads.download 폐기 (SW initiator는 DNR 미적용 → 403).
//   iframe의 sub_frame 요청이 Rule 1에 매칭되어 attachment로 다운로드된다.
// ============================================================================
async function runIframeDownloadLoop(tabId, targets) {
  for (let i = 0; i < targets.length; i++) {
    const t = targets[i];
    const separator = t.url.includes("?") ? "&" : "?";
    const triggerUrl = t.url + separator + t.ruleToken;

    // 진행 상황 팝업 브로드캐스트 (팝업이 열려 있으면 순차 큐 표시)
    broadcastToPopup({
      action: "DOWNLOAD_PROGRESS",
      current: i + 1,
      total: targets.length,
      fileName: t.fileName
    });

    console.log(
      "[LMS Helper] [" + (i + 1) + "/" + targets.length + "] iframe 주입:",
      triggerUrl
    );

    try {
      await chrome.scripting.executeScript({
        target: { tabId: tabId },
        func: (dlUrl) => {
          const iframe = document.createElement("iframe");
          iframe.style.display = "none";
          iframe.src = dlUrl;
          document.body.appendChild(iframe);

          // 브라우저가 다운로드를 인계받으면 5초 뒤 DOM에서 제거 (메모리 정리)
          setTimeout(() => iframe.remove(), 5000);
        },
        args: [triggerUrl]
      });
    } catch (err) {
      console.error("[LMS Helper] " + (i + 1) + "번째 iframe 주입 실패:", err);
    }

    // 마지막 타깃이 아니면 1초 대기 후 다음 iframe 주입
    if (i < targets.length - 1) {
      await new Promise((r) => setTimeout(r, IFRAME_INTERVAL_MS));
    }
  }
}

// ============================================================================
// 5-2. 완료/오류 공용 종료 처리
// ============================================================================

// 다운로드 완료: OK 배지 → 3초 후 자동 클리어 (단, 그 사이 새 배지가 세팅되면
// 보존되도록 현재 배지가 여전히 OK 인 경우에만 비운다)
async function finalizeDownload(tabId, total) {
  setBadge(tabId, "OK", "#4CAF50");

  setTimeout(async () => {
    try {
      const current = await chrome.action.getBadgeText({ tabId: tabId });
      if (current === "OK") clearBadge(tabId);
    } catch (e) {
      clearBadge(tabId);
    }
  }, BADGE_RESET_MS);

  // 다운로드 결과를 탭 상태에 기록 (팝업 재표시 시 완료 안내용)
  await patchTabState(tabId, { downloadStatus: "ok" });

  broadcastToPopup({
    action: "DOWNLOAD_COMPLETE",
    total: total,
    message: "다운로드를 완료했습니다. (" + total + "개 파일)"
  });
  return { ok: true, total: total };
}

async function handleDownloadError(tabId, error) {
  console.error("[LMS Helper] 처리 중 에러 발생:", error);
  setBadge(tabId, "ERR", "#F44336");
  await patchTabState(tabId, { downloadStatus: "error" });
  broadcastToPopup({
    action: "DOWNLOAD_ERROR",
    message: String(error && error.message ? error.message : error)
  });
  return { ok: false, reason: "error" };
}

// ----------------------------------------------------------------------------
// 5-3. 팝업(열려 있는 확장 페이지)으로 이벤트 브로드캐스트
//   background → popup 의 다운로드 진행/완료 통지용.
//   수신처(팝업)가 없으면 조용히 무시된다.
// ----------------------------------------------------------------------------
function broadcastToPopup(payload) {
  try {
    chrome.runtime.sendMessage(payload);
  } catch (e) {
    // 수신처 없음 — 무시
  }
}