// ============================================================================
// KULMS Video Downloader — popup.js (v1.4.2)
//   - chrome.storage.session(SSOT) 을 직접 조회해 SW 기상 지연과 무관하게 즉시 렌더링
//   - 백그라운드 CHECK_STATUS 로 강의명·파트 수 등 세부 정보를 비동기 보강
//   - 상태 분기 UI: 미감지 / 재생 대기(멀티) / 감지완료(멀티·단일) / 진행·완료
//
//   SSOT 스키마 (background.js 와 동일)
//     key: `tab_${tabId}`
//     value: {
//       type: "multi"|"single",
//       status: "waiting_play"|"captured",
//       title, xmlUrl, videoUrl, partCount, downloadStatus
//     }
// ============================================================================

// [병합 도구] 실제 배포용 GitHub 릴리즈 페이지 주소로 교체해서 사용하세요.
// TODO: 릴리즈 배포 시 아래 주소만 실제 저장소(예: https://github.com/계정명/저장소명/releases/latest)로 교체
const TAURI_APP_RELEASE_URL = "https://github.com/";

const TYPE_MULTI = "multi";
const TYPE_SINGLE = "single";
const STATUS_WAITING_PLAY = "waiting_play";
const STATUS_CAPTURED = "captured";

document.addEventListener('DOMContentLoaded', async () => {
  const statusBox = document.getElementById('statusBox');
  const guideBox = document.getElementById('guideBox');
  const progressBox = document.getElementById('progressBox');
  const downloadBtn = document.getElementById('downloadBtn');
  const tauriLink = document.getElementById('tauriLink');

  // 현재 활성 탭
  const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
  const tabId = tab.id;

  // 다운로드 진행 중 플래그 — 진행 중에는 상태 렌더링을 배경 이벤트에 위임
  let downloading = false;

  // ------------------------------------------------------------------
  // 1. SSOT(chrome.storage.session) 직접 조회 → SW 기상 지연과 무관하게 즉시 렌더링
  // ------------------------------------------------------------------
  let sessionState = null;
  try {
    const key = "tab_" + tabId;
    const loaded = await chrome.storage.session.get(key);
    sessionState = (loaded && loaded[key]) || null;
  } catch (e) {
    sessionState = null;
  }
  renderState(sessionState);

  // ------------------------------------------------------------------
  // 2. 백그라운드 상태 동기화 (비동기 보강: 강의명·파트 수 지연 확정 등)
  //    SW 가 아직 Inactive 여도 응답이 돌아오는 즉시 렌더링을 갱신한다.
  // ------------------------------------------------------------------
  chrome.runtime.sendMessage({ action: "CHECK_STATUS", tabId: tabId }, (response) => {
    if (response) renderState(response);
  });

  // ------------------------------------------------------------------
  // 3. 다운로드 시작 — 팝업을 닫지 않고 순차 큐 진행 상황을 표시한다.
  //    (백그라운드의 iframe 순차 주입은 탭 기반이라 팝업과 무관하게 계속됨)
  // ------------------------------------------------------------------
  downloadBtn.addEventListener('click', () => {
    downloading = true;
    downloadBtn.disabled = true;
    downloadBtn.innerText = "다운로드 준비 중...";
    chrome.runtime.sendMessage({ action: "START_DOWNLOAD", tabId: tabId });
    // 잠시 뒤 "진행 중" 상태로 전환 (백그라운드의 DOWNLOAD_PROGRESS 가 도착하면 갱신)
    setTimeout(() => {
      if (downloading) downloadBtn.innerText = "다운로드 진행 중...";
    }, 300);
  });

  // ------------------------------------------------------------------
  // 4. 백그라운드 → 팝업 이벤트 (순차 다운로드 큐 / 완료 / 오류)
  // ------------------------------------------------------------------
  chrome.runtime.onMessage.addListener((msg) => {
    if (!msg || !msg.action) return;
    switch (msg.action) {
      case "DOWNLOAD_PROGRESS":
        showProgress(msg.current, msg.total, msg.fileName);
        break;
      case "DOWNLOAD_COMPLETE":
        downloading = false;
        showComplete(msg.total, msg.message);
        break;
      case "DOWNLOAD_ERROR":
        downloading = false;
        showError(msg.message);
        break;
    }
  });

  // ------------------------------------------------------------------
  // 5. Tauri 병합 도구 배너 → 새 탭으로 안전하게 오픈
  //    (익스텐션 팝업 내 내비게이션 제한 회피: chrome.tabs.create 사용)
  // ------------------------------------------------------------------
  tauriLink.addEventListener('click', (e) => {
    e.preventDefault();
    chrome.tabs.create({ url: TAURI_APP_RELEASE_URL, active: false });
  });

  // ================================================================
  // UI 렌더링 헬퍼
  // ================================================================

  function setGuide(mode, text) {
    guideBox.classList.remove('warn', 'ok');
    guideBox.classList.add(mode === 'ok' ? 'ok' : 'warn');
    guideBox.style.display = 'block';
    guideBox.textContent = text;
  }

  // ---- 상태 분기 렌더링 (세션 SSOT 객체 또는 백그라운드 응답 사용) ----
  function renderState(state) {
    // 다운로드 진행 중에는 진행 이벤트가 UI 를 담당 → 상태 렌더링 스킵
    if (downloading) return;

    const has = !!(state && (state.plan || (state.type && state.status)));

    // -- 완료/실패 이력 안내 (downloadStatus) --
    if (has && state.downloadStatus === "ok") {
      statusBox.innerHTML = "<b>✅ 이 강의는 다운로드가 완료된 상태입니다.</b>";
      setGuide('ok', "브라우저 다운로드 폴더를 확인해주세요. 다시 받으려면 버튼을 눌러주세요.");
      downloadBtn.disabled = false;
      downloadBtn.innerText = "다시 다운로드";
      return;
    }
    if (has && state.downloadStatus === "error") {
      statusBox.innerHTML = "<b>❌ 직전 다운로드가 실패했습니다.</b>";
      setGuide('warn', "확장 프로그램 상세 오류 콘솔(우클릭 → 검사)을 확인해주세요.");
      downloadBtn.disabled = false;
      downloadBtn.innerText = "다시 시도";
      return;
    }

    // -- 상태 1: 미감지 --
    if (!has) {
      statusBox.innerHTML = "<b>아직 강의 영상이 감지되지 않았습니다.</b>";
      setGuide('warn',
        "아직 강의 영상이 감지되지 않았습니다. 화면의 동영상을 1초 이상 재생(클릭)한 뒤 다시 확인해주세요.");
      downloadBtn.disabled = true;
      downloadBtn.innerText = "강의 다운로드";
      return;
    }

    // -- 상태 2: 다운로드 준비/재생 대기 --
    if (state.status === STATUS_WAITING_PLAY) {
      // chapter 유효 + 파트 ID 확보, 단 영상 경로(base) 미확보
      if (state.planReason === "part_info_ready_media_path_pending") {
        statusBox.innerHTML =
          "<b>파트 정보 확보</b> — 영상 경로 확인 대기 중입니다.";
        setGuide('warn',
          "본편 영상이 감지되면 파트 다운로드가 준비됩니다. 화면의 동영상을 1초 이상 재생(클릭)해주세요.");
        downloadBtn.disabled = true;
        downloadBtn.innerText = "영상 경로 확인 대기";
        return;
      }
      // chapter.xml 은 찾았지만 아직 plan 이 없는 경우와,
      // 아무 신호도 없는 경우를 구분해 안내한다.
      const structureFound = state.planReason === "chapter_found_awaiting" ||
        state.type === TYPE_MULTI;
      statusBox.innerHTML = structureFound
        ? "<b>강의 구조(chapter.xml)는 감지됨</b> — 본 영상 재생 대기 중입니다."
        : "<b>강의 구조만 감지됨</b> — 본 영상 재생 대기 중입니다.";
      setGuide('warn',
        "본 영상(screen.mp4 등)을 1초 이상 재생(클릭)하면 다운로드가 활성화됩니다.");
      downloadBtn.disabled = true;
      downloadBtn.innerText = "재생 후 다운로드 가능";
      return;
    }

    // -- 상태 3: 다운로드 계획 선택 완료 (multipart / single) --
    if (state.status === STATUS_CAPTURED) {
      const lines = [];
      if (state.title) lines.push("강의: " + state.title);

      if (state.plan === "multipart") {
        lines.push("분할 파트 " + (state.partCount || 0) + "개 준비됨");
      } else if (state.plan === "single") {
        const why = state.planReason === "chapter_invalid_live_verified"
          ? "chapter.xml 무효"
          : "chapter.xml 없음";
        lines.push("단일 영상 1개 준비됨 (" + why + ")");
      } else {
        lines.push("감지된 영상 1개 준비됨");
      }

      statusBox.innerHTML =
        "<b>🎯 강의 영상이 포착되었습니다.</b><br>" + lines.join("<br>");
      setGuide('ok', state.plan === "multipart"
        ? "클릭 시 전체 파트가 순차 다운로드됩니다. (분할 파트 수만큼 자동 저장)"
        : "클릭 시 영상이 다운로드 폴더에 저장됩니다.");
      downloadBtn.disabled = false;
      downloadBtn.innerText = "강의 다운로드";
      return;
    }
  }

  // ---- 상태 3: 순차 다운로드 큐 진행 상황 표시 ----
  function showProgress(current, total, fileName) {
    progressBox.style.display = 'block';
    const rows = [];
    for (let i = 1; i <= total; i++) {
      const done = i < current ? "✓" : (i === current ? "▶" : "·");
      const name = i === current ? fileName : "";
      rows.push(
        '<div style="display:flex;gap:6px;align-items:center;">' +
          '<span style="min-width:18px;color:#2e7d32;font-weight:700;">' + done + '</span>' +
          '<span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;font-size:11.5px;color:#4a5a7a;">' +
            "Part " + i + (name ? " — " + emphasize(name) : "") +
          '</span>' +
        '</div>'
      );
    }
    progressBox.innerHTML =
      '<b>순차 다운로드 (' + current + '/' + total + ')</b><br>' + rows.join("");
  }

  function emphasize(name) {
    // 파일명 내 인라인 html 특수문자 이스케이프
    return String(name).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function showComplete(total, message) {
    statusBox.innerHTML = "<b>🎉 모든 다운로드가 완료되었습니다!</b><br>" +
      (total ? "총 " + total + "개 파일" : "");
    setGuide('ok', message || "브라우저 다운로드 폴더에서 저장된 파일을 확인해주세요.");
    progressBox.style.display = 'none';
    downloadBtn.disabled = false;
    downloadBtn.innerText = "강의 다운로드";
  }

  function showError(message) {
    statusBox.innerHTML = "<b>❌ 다운로드 중 오류가 발생했습니다.</b>";
    setGuide('warn', message || "확장 프로그램 오류 콘솔을 확인해주세요.");
    progressBox.style.display = 'none';
    downloadBtn.disabled = false;
    downloadBtn.innerText = "다시 시도";
  }
});