<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    /* ============================================================
       KULMS Video Downloader — popup.html (v1.4.2)
       상태 분기형 UI: 미감지 / 감지완료 / 다운로드 진행·완료
       + 다중 다운로드 허용 경고(상시) + Tauri 병합 도구 배너
       ============================================================ */
    :root { color-scheme: light; }
    body {
      width: 300px;
      padding: 14px 14px 16px;
      margin: 0;
      font-family: -apple-system, "Segoe UI", sans-serif;
      font-size: 13px;
      background: #ffffff;
      color: #333;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      box-sizing: border-box;
    }
    h3 {
      margin: 0 0 2px 0;
      font-size: 15px;
      color: #111;
      font-weight: 700;
    }
    .subtitle {
      margin: 0 0 14px 0;
      font-size: 11px;
      color: #8a8f98;
    }

    /* ---- 상태 안내 박스 (동적) ---- */
    #statusBox {
      margin: 0 0 8px 0;
      padding: 10px 10px;
      border-radius: 8px;
      background: #f2f4f7;
      border-left: 4px solid #c9cdd3;
      font-size: 13px;
      line-height: 1.5;
      color: #444;
      word-break: break-word;
    }

    /* ---- 상태별 가이드 박스 (동적) ---- */
    #guideBox {
      display: none; /* 자바스크립트에서 상태에 따라 노출 */
      margin: 0 0 12px 0;
      padding: 9px 10px;
      border-radius: 8px;
      font-size: 12px;
      line-height: 1.5;
    }
    #guideBox.warn { background: #fff3e0; color: #8a5b00; border: 1px solid #ffd9a3; }
    #guideBox.ok   { background: #e8f5e9; color: #1e6f2e; border: 1px solid #b5ddb5; }

    /* ---- 다운로드 진행 상황 (순차 큐) ---- */
    #progressBox {
      display: none;
      margin: 0 0 12px 0;
      padding: 9px 10px;
      border-radius: 8px;
      background: #f6f8ff;
      border: 1px solid #cdd7f0;
      font-size: 12px;
      line-height: 1.6;
      color: #3a4a6b;
    }

    /* ---- 다운로드 버튼: 기본 비활성화(미감지), 감지 시 활성화 ---- */
    #downloadBtn {
      width: 100%;
      padding: 10px;
      font-weight: bold;
      font-size: 13px;
      color: #fff;
      background: #007aff;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: 0.2s;
      margin: 0 0 12px 0;
    }
    #downloadBtn:hover:not(:disabled) { background: #005bb5; }
    #downloadBtn:disabled { background: #cfd4da; color: #9aa0a8; cursor: not-allowed; }

    /* ---- 다중 다운로드 허용 필수 경고 (상시 표시) ---- */
    #dlWarning {
      margin: 0 0 10px 0;
      padding: 9px 10px;
      border-radius: 8px;
      background: #fff7ef;
      border: 1px solid #ffc9a3;
      border-left: 4px solid #ff8c42;
      font-size: 12px;
      line-height: 1.55;
      color: #8a4b1c;
    }
    #dlWarning b { color: #c0392b; }

    /* ---- 영상 병합 도구 (Tauri Desktop App) 연계 배너 ---- */
    #tauriLink {
      display: block;
      text-align: center;
      text-decoration: none;
      padding: 9px 10px;
      border-radius: 8px;
      background: linear-gradient(135deg, #6a4cf3, #8e5cf8);
      color: #fff;
      font-size: 12px;
      font-weight: 600;
      transition: 0.2s;
    }
    #tauriLink:hover { filter: brightness(1.12); }
    #tauriLink .sub {
      display: block;
      font-size: 10.5px;
      opacity: 0.85;
      margin-top: 2px;
    }
  </style>
</head>
<body>
  <h3>LMS Downloader</h3>
  <div class="subtitle">v1.4.2 — 분할 강의 순차 다운로드</div>

  <!-- (동적) 상태 안내 박스: 미감지 / 감지완료 / 다운로드 진행·완료 -->
  <div id="statusBox">상태 확인 중...</div>

  <!-- (동적) 상태별 가이드: 재생 안내 / 포착 완료 안내 등 -->
  <div id="guideBox" class="warn"></div>

  <!-- (상태 3) 다운로드 순차 큐 진행 상황 -->
  <div id="progressBox"></div>

  <!-- 다운로드 버튼: 미감지 시 비활성화 -->
  <button id="downloadBtn" disabled>강의 다운로드</button>

  <!-- 다중 다운로드 권한 필수 경고 (상시 표시) -->
  <div id="dlWarning">
    ⚠️ 최초 다운로드 시 브라우저 좌측 상단/우측 상단에
    '여러 파일 다운로드 허용' 팝업이 뜨면 반드시 <b>[허용]</b>을 눌러주셔야
    모든 파트가 정상 저장됩니다.
  </div>

  <!-- 영상 병합 도구 (Tauri Desktop App) 연계 배너 -->
  <a id="tauriLink" href="#" target="_blank" rel="noopener noreferrer"
     role="button" title="분할 영상 무료 병합 도구 (Tauri Desktop App)">
    ✂️ ➜ 🎬 분할 영상 무료 병합 도구 (Tauri Desktop App)
    <span class="sub">Part 1~N 을 하나의 강의 영상으로 합치기</span>
  </a>

  <script src="popup.js"></script>
</body>
</html>